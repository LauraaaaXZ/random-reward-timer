{
  "expo": {
    "name": "Random Reward Timer",
    "slug": "random-reward-timer",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      ["expo-calendar", {"calendarPermission": "Allow Random Reward Timer to read selected calendars for scheduling."}]
    ],
    "android": {
      "package": "com.randomrewardtimer.app",
      "permissions": ["android.permission.READ_CALENDAR"]
    }
  }
}
